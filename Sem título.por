programa {
  funcao inicio() {
    real num1, num2, resultado
    caracter operacao 
    // declaração de variavel
     escreva("Digite o primeiro número:")
      leia(num1)

       escreva("Digite o segundo número:")
       leia(num2)
       escreva("a operação(+,-,*,/)")
       leia(operacao)

       se(operacao == '+'){
         resultado = num1 + num2
         
       }
       
       se(operacao == '-'){
        resultado = num1 - num2
       }

       se(operacao == '*'){
        resultado = num1 * num2
       }

       se(operacao == '/'){
        se(num2 )
       }
  }
}
